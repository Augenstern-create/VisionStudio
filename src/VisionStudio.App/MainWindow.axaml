<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:VisionStudio.App"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="VisionStudio.App.MainWindow"
        Title="" Width="1480" Height="920" MinWidth="1100" MinHeight="680"
        Icon="/Assets/VisionStudio.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid>
    <!-- IDE-style start center -->
    <Grid x:Name="WelcomeView" RowDefinitions="46,*" Background="{DynamicResource WorkbenchBrush}">
      <Border x:Name="WelcomeTitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1" PointerPressed="TitleBar_PointerPressed"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,245,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource PrimaryBrush}">
              <TextBlock Text="V" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
            </Border>
            <TextBlock Text="VISION STUDIO" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="WelcomeTabText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Menu Grid.Column="2" Background="Transparent" VerticalAlignment="Center"
                chrome:WindowDecorationProperties.ElementRole="User">
            <MenuItem x:Name="WelcomeViewMenuItem" Classes="topMenuItem">
              <MenuItem x:Name="WelcomeLanguageMenuItem">
                <MenuItem x:Name="WelcomeChineseMenuItem" Tag="zh-CN" ToggleType="Radio" Click="LanguageMenuItem_Click" />
                <MenuItem x:Name="WelcomeEnglishMenuItem" Tag="en-US" ToggleType="Radio" Click="LanguageMenuItem_Click" />
              </MenuItem>
              <MenuItem x:Name="WelcomeThemeMenuItem">
                <MenuItem x:Name="WelcomeDarkThemeMenuItem" Tag="Dark" ToggleType="Radio" Click="ThemeMenuItem_Click" />
                <MenuItem x:Name="WelcomeLightThemeMenuItem" Tag="Light" ToggleType="Radio" Click="ThemeMenuItem_Click" />
                <MenuItem x:Name="WelcomeGradientThemeMenuItem" Tag="Gradient" ToggleType="Radio" Click="ThemeMenuItem_Click" />
              </MenuItem>
            </MenuItem>
          </Menu>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Width="1040" MaxWidth="1040" ColumnDefinitions="430,*,500" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="16" Margin="0,0,30,0">
          <Border Width="58" Height="58" HorizontalAlignment="Left" CornerRadius="12" Background="{DynamicResource PrimaryBrush}">
            <TextBlock Text="V" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
          </Border>
          <TextBlock Text="Vision Studio" FontSize="38" FontWeight="SemiBold" LetterSpacing="0.3" />
          <TextBlock x:Name="WelcomeSubtitleText" FontSize="17" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="390" />
          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,60,8" />
          <StackPanel Spacing="9">
            <TextBlock x:Name="WelcomeFeatureOneText" Foreground="{DynamicResource FeatureOneBrush}" FontSize="13" />
            <TextBlock x:Name="WelcomeFeatureTwoText" Foreground="{DynamicResource FeatureTwoBrush}" FontSize="13" />
            <TextBlock x:Name="WelcomeFeatureThreeText" Foreground="{DynamicResource FeatureThreeBrush}" FontSize="13" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="0,20" />

        <StackPanel Grid.Column="2" Spacing="14" Margin="38,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="WelcomeSectionText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,3" />
          <Button Width="462" Height="112" Click="NewProject_Click" HorizontalContentAlignment="Stretch" Classes="projectCard">
            <Grid ColumnDefinitions="52,*">
              <Border Width="42" Height="42" CornerRadius="6" Background="#263E4D" VerticalAlignment="Top">
                <TextBlock Text="＋" FontSize="25" Foreground="#4FC1FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="7" Margin="14,0,0,0">
                <TextBlock x:Name="NewProjectTitleText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="NewProjectDescriptionText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Width="462" Height="112" Click="OpenProject_Click" HorizontalContentAlignment="Stretch" Classes="projectCard">
            <Grid ColumnDefinitions="52,*">
              <Border Width="42" Height="42" CornerRadius="6" Background="#35352A" VerticalAlignment="Top">
                <TextBlock Text="⌂" FontSize="24" Foreground="#DCDCAA" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="7" Margin="14,0,0,0">
                <TextBlock x:Name="OpenProjectTitleText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="OpenProjectDescriptionText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Button>
          <TextBlock x:Name="WelcomeStatusText" Foreground="{DynamicResource MutedTextBrush}" Margin="3,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- VS Code / Visual Studio inspired workbench -->
    <Grid x:Name="EditorView" IsVisible="False" RowDefinitions="44,*,22" ColumnDefinitions="52,280,4,*,4,356">
      <Border x:Name="EditorTitleBar" Grid.Row="0" Grid.ColumnSpan="6" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1" PointerPressed="TitleBar_PointerPressed"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <Grid ColumnDefinitions="Auto,*,245" Margin="8,0">
          <Menu Grid.Column="0" Background="Transparent" VerticalAlignment="Center"
                chrome:WindowDecorationProperties.ElementRole="User">
              <MenuItem x:Name="FileMenuItem" Classes="topMenuItem">
                <MenuItem x:Name="SaveMenuItem" Click="Save_Click" />
                <MenuItem x:Name="ExportMenuItem" Click="Export_Click" />
                <Separator />
                <MenuItem x:Name="SettingsMenuItem" Click="Settings_Click" />
                <Separator />
                <MenuItem x:Name="CloseFolderMenuItem" Click="CloseFolder_Click" />
              </MenuItem>
              <MenuItem x:Name="QuickActionsMenuItem" Classes="topMenuItem">
                <MenuItem x:Name="UndoMenuItem" Click="Undo_Click" />
                <MenuItem x:Name="AutoLayoutMenuItem" Click="AutoLayout_Click" />
              </MenuItem>
              <MenuItem x:Name="ViewMenuItem" Classes="topMenuItem">
                <MenuItem x:Name="HistoryMenuItem" ToggleType="CheckBox" IsChecked="False" Click="HistoryMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="LanguageMenuItem">
                  <MenuItem x:Name="ChineseMenuItem" Tag="zh-CN" ToggleType="Radio" Click="LanguageMenuItem_Click" />
                  <MenuItem x:Name="EnglishMenuItem" Tag="en-US" ToggleType="Radio" Click="LanguageMenuItem_Click" />
                </MenuItem>
                <MenuItem x:Name="ThemeMenuItem">
                  <MenuItem x:Name="DarkThemeMenuItem" Tag="Dark" ToggleType="Radio" Click="ThemeMenuItem_Click" />
                  <MenuItem x:Name="LightThemeMenuItem" Tag="Light" ToggleType="Radio" Click="ThemeMenuItem_Click" />
                  <MenuItem x:Name="GradientThemeMenuItem" Tag="Gradient" ToggleType="Radio" Click="ThemeMenuItem_Click" />
                </MenuItem>
              </MenuItem>
              <MenuItem x:Name="HelpMenuItem" Classes="topMenuItem">
                <MenuItem x:Name="AboutMenuItem" Click="About_Click" />
              </MenuItem>
          </Menu>
          <TextBox Grid.Column="1" x:Name="OperatorSearchBox" Width="390" Height="30" Padding="12,4"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextChanged="OperatorSearchBox_TextChanged"
                   Classes="titleSearch" chrome:WindowDecorationProperties.ElementRole="User" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ActivityBarBrush}"
              BorderBrush="{DynamicResource ActivityBarBorderBrush}" BorderThickness="0,0,1,0" ZIndex="3">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,2,0,2">
          <Button x:Name="OperatorsActivityButton" Grid.Row="0" Classes="activity selected" Click="OperatorsActivity_Click"
                  ToolTip.Tip="Operators" AutomationProperties.Name="▦">
            <PathIcon Width="24" Height="24" Data="M3,4 L9,4 L11,6 L21,6 L21,19 L3,19 Z M6,9 L18,9 M6,12 L18,12 M6,15 L15,15" />
          </Button>
          <Button x:Name="AiActivityButton" Grid.Row="1" Classes="activity" Click="AiActivity_Click"
                  ToolTip.Tip="AI" AutomationProperties.Name="✦">
            <PathIcon Width="24" Height="24" Data="M12,2 L13.7,8.3 L20,10 L13.7,11.7 L12,18 L10.3,11.7 L4,10 L10.3,8.3 Z M19,15 L19.8,18.2 L23,19 L19.8,19.8 L19,23 L18.2,19.8 L15,19 L18.2,18.2 Z" />
          </Button>
          <Button x:Name="ActivitySettingsButton" Grid.Row="3" Classes="activity" Click="Settings_Click"
                  ToolTip.Tip="Settings" AutomationProperties.Name="⚙">
            <PathIcon Width="24" Height="24" Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M19.4,13 A7.6,7.6 0 0 0 19.4,11 L22,9 L20,5.5 L16.8,6.8 A7.6,7.6 0 0 0 15,5.8 L14.5,2 L9.5,2 L9,5.8 A7.6,7.6 0 0 0 7.2,6.8 L4,5.5 L2,9 L4.6,11 A7.6,7.6 0 0 0 4.6,13 L2,15 L4,18.5 L7.2,17.2 A7.6,7.6 0 0 0 9,18.2 L9.5,22 L14.5,22 L15,18.2 A7.6,7.6 0 0 0 16.8,17.2 L20,18.5 L22,15 Z" />
          </Button>
        </Grid>
      </Border>

      <Border x:Name="OperatorSidebar" Grid.Row="1" Grid.Column="1" Background="{DynamicResource SideBarBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" ZIndex="2">
        <Grid RowDefinitions="35,*">
          <Border Background="{DynamicResource SideBarHeaderBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
            <TextBlock x:Name="OperatorsTitleText" Classes="panelTitle" />
          </Border>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PalettePanel" Spacing="0" Margin="0,3,0,10" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Border x:Name="AiSidebar" Grid.Row="1" Grid.Column="1" Background="{DynamicResource SideBarBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" ZIndex="2" IsVisible="False">
        <Grid RowDefinitions="35,Auto,Auto,Auto,*,Auto,Auto">
          <Border Background="{DynamicResource SideBarHeaderBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="AiSidebarTitleText" Classes="panelTitle" />
              <Button x:Name="AiClearContextButton" Grid.Column="1" Content="↺" Classes="toolbar" Click="AiClearContext_Click" ToolTip.Tip="Clear context" />
            </Grid>
          </Border>
          <ComboBox Grid.Row="1" x:Name="AiModelComboBox" Margin="10,9,10,4" SelectionChanged="AiModelComboBox_SelectionChanged" />
          <TextBlock Grid.Row="2" x:Name="AiContextStatusText" Margin="12,3,12,7" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
          <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="86" Margin="10,0,10,5">
            <WrapPanel x:Name="AiImageReferencesPanel" Orientation="Horizontal" />
          </ScrollViewer>
          <ScrollViewer Grid.Row="4" x:Name="AiConversationScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AiConversationPanel" Margin="10,4" Spacing="8" />
          </ScrollViewer>
          <TextBox Grid.Row="5" x:Name="AiPromptTextBox" Margin="10,6" MinHeight="76" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap"
                   DragDrop.AllowDrop="True" DragDrop.DragOver="AiPrompt_DragOver" DragDrop.Drop="AiPrompt_Drop" />
          <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto" Margin="10,2,10,10" ColumnSpacing="6">
            <TextBlock x:Name="AiModeHintText" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="AiSendButton" Grid.Column="1" Click="AiSend_Click" />
            <Button x:Name="AiApplyButton" Grid.Column="2" Click="AiApply_Click" IsEnabled="False" />
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1" Grid.Column="2" Background="{DynamicResource BorderBrush}" ResizeDirection="Columns" />

      <Border x:Name="WorkflowWorkspace" Grid.Row="1" Grid.Column="3" Background="{DynamicResource WorkbenchBrush}" ClipToBounds="True" ZIndex="0">
        <Grid RowDefinitions="30,*">
          <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
              <Border Width="8" Height="8" CornerRadius="4" Background="#3FB950" />
              <TextBlock x:Name="WorkflowLabelText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <local:GraphCanvas Grid.Row="1" x:Name="Canvas" Focusable="True" ClipToBounds="True" AutomationProperties.Name="AlgorithmCanvas" />
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1" Grid.Column="4" Background="{DynamicResource BorderBrush}" ResizeDirection="Columns" />

      <Border x:Name="WorkflowInspector" Grid.Row="1" Grid.Column="5" Background="{DynamicResource SideBarBrush}" ZIndex="2">
        <Grid RowDefinitions="286,4,*,Auto">
          <Grid Grid.Row="0" RowDefinitions="38,*,Auto">
            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock x:Name="ResultTitleText" Classes="panelTitle" />
                <Button x:Name="PreviewFitButton" Grid.Column="1" Click="PreviewFit_Click" Classes="toolbar" Padding="7,3" />
                <Button Grid.Column="2" Content="−" Click="PreviewZoomOut_Click" Classes="toolbar" Padding="7,3" />
                <Button Grid.Column="3" Content="＋" Click="PreviewZoomIn_Click" Classes="toolbar" Padding="7,3" />
              </Grid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource PreviewBrush}" Margin="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
              <Grid>
                <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PointerWheelChanged="Preview_PointerWheelChanged">
                  <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ScrollViewer>
                <StackPanel x:Name="PreviewEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                  <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource HeaderBrush}">
                    <TextBlock Text="◇" FontSize="21" Foreground="{DynamicResource EmptyIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock x:Name="PreviewEmptyText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <GridSplitter Grid.Row="1" Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" />

          <Grid Grid.Row="2" RowDefinitions="38,*">
            <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
              <TextBlock x:Name="PropertiesTitleText" Classes="panelTitle" />
            </Border>
            <Grid Grid.Row="1">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PropertyPanel" Spacing="7" Margin="12,10,12,14" />
              </ScrollViewer>
              <StackPanel x:Name="PropertyEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24">
                <TextBlock Text="⌁" FontSize="28" Foreground="{DynamicResource EmptyIconBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="PropertyEmptyText" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Grid>

          <Border x:Name="HistoryPanel" Grid.Row="3" IsVisible="False" Height="190"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBrush}">
            <Grid RowDefinitions="36,*">
              <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                <TextBlock x:Name="HistoryTitleText" Classes="panelTitle" />
              </Border>
              <ListBox Grid.Row="1" x:Name="OperationList" FontSize="11" Margin="6" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="2" Grid.ColumnSpan="6" Background="{DynamicResource StatusBarBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="●" FontSize="9" Foreground="White" />
            <TextBlock Text="Vision Studio" FontSize="11" Foreground="White" />
            <Border Width="1" Height="12" Background="#66FFFFFF" Margin="3,0" />
            <TextBlock x:Name="ProjectText" FontSize="11" FontWeight="SemiBold" Foreground="White"
                       MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="StatusText" FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="18,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="OpenCV  •  .NET 9" FontSize="11" Foreground="White" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
